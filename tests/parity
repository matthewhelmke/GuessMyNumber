#!/usr/bin/env bash
# Parity check — confirm every CLI implementation produces identical
# user-visible output for the same games.
#
# Each scenario in tests/scenarios.sh is one game: a fixed secret (GMN_SECRET)
# and a fixed input from tests/fixtures/parity/<name>.txt. Every implementation
# plays every scenario, and its normalized output is diffed against Python, the
# canonical reference. A new language is "done" when it matches here, so this
# doubles as the TDD gate for future implementations.
#
# Before comparing anything, the script checks that the Python reference still
# reaches the path each scenario is named for (the EXPECT patterns). A scenario
# whose game no longer reaches its path tests nothing, so that is an error.
#
# Known divergences: tests/parity_known.txt lists the language/scenario pairs
# that are known not to match yet. Those report KNOWN and do not fail the run.
# A listed pair that now matches reports STALE and does fail it, so the list can
# only shrink: fix a language, then delete its line.
#
# The GMN_SECRET hook is checked too. Each case in HOOK_CASES sets GMN_SECRET to
# an odd value, such as +5 or 0x05, guesses the number it might be read as, and
# looks at whether that first guess wins. A version must take or ignore each
# value exactly as Python does, so a lax parser in the hook cannot go unseen.
#
# Normalization policy: forgive only the differences a language's print
# primitives force — trailing whitespace on a line, and runs of blank lines.
# Normalization therefore strips trailing whitespace and collapses consecutive
# blank lines (cat -s). Everything else must match the Python reference, or it
# is a parity bug to fix.
#
# Usage:
#   ./tests/parity              — check every implementation
#   ./tests/parity rust forth   — check a subset, and show the diffs for its
#                                 known divergences too
#
# Exit status: 0 when nothing new diverges, 1 when something does (a DIFF, a
# STALE entry, or a build or run failure), 2 when the scenarios themselves are
# broken. BASIC and HTML are skipped (they cannot take piped stdin) and are
# verified by hand.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TESTS_DIR="${REPO_ROOT}/tests"
FIXTURE_DIR="${TESTS_DIR}/fixtures/parity"
KNOWN_FILE="${TESTS_DIR}/parity_known.txt"
TIMEOUT_SEC=30
DIFF_LINES=40   # cap each diff so the worklist stays readable
MAX_OUTPUT=200000   # bytes; a whole game prints about 3 KB, so more means a runaway loop

# shellcheck source=tests/manifest.sh
source "${TESTS_DIR}/manifest.sh"
# shellcheck source=tests/scenarios.sh
source "${TESTS_DIR}/scenarios.sh"
cd "${REPO_ROOT}"

normalize() { sed -e 's/[[:space:]]*$//' | cat -s; }

# Compile one language (if it needs it) into its own temp dir, and set RUN_CMD
# to the command that runs it. Returns non-zero if it can't be built.
prepare() {
    local lang="$1" tmpdir="$2"
    local out_path="${tmpdir}/${lang}" compile_cmd
    [[ -f "${FILE[$lang]:-}" ]] || return 1

    if [[ -n "${COMPILE[$lang]:-}" ]]; then
        compile_cmd="${COMPILE[$lang]//%OUT%/$out_path}"
        compile_cmd="${compile_cmd//%TMPDIR%/$tmpdir}"
        eval "$compile_cmd" >/dev/null 2>&1 || return 1
    fi

    RUN_CMD="${RUN[$lang]:-}"
    RUN_CMD="${RUN_CMD//%OUT%/$out_path}"
    RUN_CMD="${RUN_CMD//%TMPDIR%/$tmpdir}"
}

# Play one scenario with the prepared language and print its normalized output.
# Output is cut off at MAX_OUTPUT bytes: a program that loops at end of input
# would otherwise print for the whole timeout, and closing the pipe stops it.
play() {
    local scenario="$1"
    GMN_SECRET="${SECRET[$scenario]}" timeout --kill-after=5 "$TIMEOUT_SEC" \
        bash -c "$RUN_CMD" < "${FIXTURE_DIR}/${scenario}.txt" 2>&1 \
        | head -c "$MAX_OUTPUT" | normalize
}

# Run one hook case with the prepared language, and print its verdict. Each
# argument is a guess:value pair for one run, which sets GMN_SECRET to the value
# and guesses once. The verdict is "takes" when every first guess wins, so each
# value set the secret; "random" when one does not; and "error" when a run never
# reached the first prompt. A random secret equals a guess one time in 100, so a
# correct "random" reads as "takes" one time in a million.
hook_verdict() {
    local pair guess value out
    for pair in "$@"; do
        guess="${pair%%:*}"
        value="${pair#*:}"
        out="$(printf '%s\n' "$guess" | GMN_SECRET="$value" \
            timeout --kill-after=5 "$TIMEOUT_SEC" bash -c "$RUN_CMD" 2>&1 \
            | head -c "$MAX_OUTPUT")"
        if ! grep -q 'What is your guess?' <<<"$out"; then echo error; return; fi
        if ! grep -q 'It took 1 total guesses\.' <<<"$out"; then echo random; return; fi
    done
    echo takes
}

mapfile -t SCENARIOS < <(printf '%s\n' "${!SECRET[@]}" | sort)

# --- Check the scenarios before trusting them ---------------------------------

broken=0
declare -A REF
reftmp="$(mktemp -d)"
prepare python "$reftmp" || { echo "ERROR: could not run the Python reference" >&2; exit 2; }
for scenario in "${SCENARIOS[@]}"; do
    if [[ ! -f "${FIXTURE_DIR}/${scenario}.txt" || -z "${EXPECT[$scenario]:-}" ]]; then
        echo "ERROR: scenario '$scenario' needs both a fixture and an EXPECT entry" >&2
        broken=1; continue
    fi
    REF[$scenario]="$(play "$scenario")"
    while IFS= read -r pattern; do
        if ! grep -Eq -- "$pattern" <<<"${REF[$scenario]}"; then
            echo "ERROR: scenario '$scenario' no longer reaches its path;" \
                 "the Python output does not match: $pattern" >&2
            broken=1
        fi
    done <<<"${EXPECT[$scenario]}"
done
# The hook cases state what Python does, so Python must agree with every one.
for case in "${HOOK_CASES[@]}"; do
    IFS='|' read -r -a fields <<<"$case"
    verdict="${fields[0]}" label="${fields[1]}"
    got="$(hook_verdict "${fields[@]:2}")"
    if [[ "$got" != "$verdict" ]]; then
        echo "ERROR: hook case '$label' expects '$verdict', but Python gives '$got'" >&2
        broken=1
    fi
done
rm -rf "$reftmp"

# Known divergences: "language scenario  # why" per line. Each entry must name a
# real language and scenario, or a typo would hide a divergence forever.
declare -A KNOWN
if [[ -f "$KNOWN_FILE" ]]; then
    while read -r lang scenario _; do
        [[ -z "$lang" || "$lang" == \#* ]] && continue
        if [[ -z "${LANGS[$lang]:-}" || -z "${SECRET[$scenario]:-}" ]]; then
            echo "ERROR: parity_known.txt names an unknown language or scenario: $lang $scenario" >&2
            broken=1; continue
        fi
        KNOWN["$lang $scenario"]=1
    done < "$KNOWN_FILE"
fi

[[ $broken -ne 0 ]] && exit 2

# --- Compare every implementation against the reference -----------------------

show_known=0
if [[ $# -gt 0 ]]; then
    mapfile -t TARGETS < <(printf '%s\n' "$@")
    show_known=1
else
    mapfile -t TARGETS < <(printf '%s\n' "${!LANGS[@]}" | sort)
fi

fails=0
known_total=0
printf 'Parity check against Python: %d scenarios, %d hook cases\n\n' \
    "${#SCENARIOS[@]}" "${#HOOK_CASES[@]}"
for lang in "${TARGETS[@]}"; do
    if [[ -z "${LANGS[$lang]:-}" ]]; then
        printf '  %-10s NOT IN MANIFEST\n' "$lang"; fails=$((fails+1)); continue
    fi
    if [[ -n "${SKIP[$lang]:-}" ]]; then
        printf '  %-10s SKIP  %s\n' "$lang" "${SKIP[$lang]}"; continue
    fi

    tmpdir="$(mktemp -d)"
    if ! prepare "$lang" "$tmpdir"; then
        printf '  %-10s ERROR (could not build)\n' "$lang"
        fails=$((fails+1)); rm -rf "$tmpdir"; continue
    fi

    matched=0
    known=()
    problems=()
    report=""
    for scenario in "${SCENARIOS[@]}"; do
        out="$(play "$scenario")"
        listed="${KNOWN["$lang $scenario"]:-}"
        if [[ "$out" == "${REF[$scenario]}" ]]; then
            if [[ -n "$listed" ]]; then
                problems+=("STALE:$scenario")
                report+="        $scenario now matches; delete its line from parity_known.txt"$'\n'
            else
                matched=$((matched+1))
            fi
        else
            if [[ -n "$listed" ]]; then
                known+=("$scenario")
                [[ $show_known -eq 0 ]] && continue
                report+="        --- $scenario (known)"$'\n'
            else
                problems+=("DIFF:$scenario")
                report+="        --- $scenario"$'\n'
            fi
            report+="$(diff <(printf '%s\n' "${REF[$scenario]}") <(printf '%s\n' "$out") \
                | head -n "$DIFF_LINES" | sed 's/^/        /')"$'\n'
        fi
    done

    hooked=0
    for case in "${HOOK_CASES[@]}"; do
        IFS='|' read -r -a fields <<<"$case"
        verdict="${fields[0]}" label="${fields[1]}"
        got="$(hook_verdict "${fields[@]:2}")"
        if [[ "$got" == "$verdict" ]]; then
            hooked=$((hooked+1)); continue
        fi
        problems+=("HOOK:$label")
        example="GMN_SECRET=$(printf '%q' "${fields[2]#*:}")"
        case "$got" in
            takes)  report+="        hook $label: values such as $example set the secret; Python ignores them"$'\n' ;;
            random) report+="        hook $label: values such as $example were ignored; Python takes them"$'\n' ;;
            *)      report+="        hook $label: $example stopped the program before its first prompt"$'\n' ;;
        esac
    done
    rm -rf "$tmpdir"

    line="$(printf '  %-10s %2d match, %2d hook' "$lang" "$matched" "$hooked")"
    [[ ${#known[@]} -gt 0 ]] && line+=", ${#known[@]} known"
    [[ ${#problems[@]} -gt 0 ]] && line+="  ${problems[*]}"
    printf '%s\n' "$line"
    [[ -n "$report" ]] && printf '%s' "$report"

    known_total=$((known_total + ${#known[@]}))
    fails=$((fails + ${#problems[@]}))
done

printf '\n'
if [[ $fails -gt 0 ]]; then
    printf '%d new divergence(s) or stale known entries.\n' "$fails"
    exit 1
fi
printf 'No new divergences. %d known divergence(s) remain in parity_known.txt.\n' "$known_total"
exit 0
