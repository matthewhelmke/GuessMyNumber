  as published by the Free Software Foundation; either version 2
  of the License, or (at your option) any later version.

  This program is distributed in the hope that it will be useful,
  but WITHOUT ANY WARRANTY; without even the implied warranty of
  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
  GNU General Public License for more details.

  You should have received a copy of the GNU General Public License
  along with this program; if not, write to the Free Software
  Foundation, Inc., 59 Temple Place - Suite 330, Boston, MA  02111-1307, USA.
COMMENT

BEGIN
   # True for the two characters a guess may be padded with: space and tab #
   PROC is blank = (CHAR c) BOOL: c = " " OR c = REPR 9;

   # Remove leading and trailing spaces and tabs, and nothing else.
     AND evaluates both of its operands, so each loop condition is an
     IF that looks at a character only while one is left to look at. #
   PROC trim = (STRING s) STRING:
      BEGIN
         INT first := LWB s, last := UPB s;
         WHILE IF first <= last THEN is blank (s[first]) ELSE FALSE FI
         DO first +:= 1 OD;
         WHILE IF last >= first THEN is blank (s[last]) ELSE FALSE FI
         DO last -:= 1 OD;
         s[first:last]
      END;

   # True only for a non-empty string of the digits 0 to 9 #
   PROC is all digits = (STRING s) BOOL:
      BEGIN
         BOOL alldigits := UPB s >= LWB s;
         FOR i FROM LWB s TO UPB s DO
            IF s[i] < "0" OR s[i] > "9" THEN alldigits := FALSE FI
         OD;
         alldigits
      END;

   # Convert a string of digits to a number. Any value above 100 is out of
     range, so the value stops growing at 101; a long run of digits then
     cannot overflow an integer. #
   PROC digits to number = (STRING s) INT:
      BEGIN
         INT value := 0;
         FOR i FROM LWB s TO UPB s DO
            value := value * 10 + (ABS s[i] - ABS "0");
            IF value > 100 THEN value := 101 FI
         OD;
         value
      END;

   # Print a description of the game, with rules, to the screen #
   print (("Welcome to Guess My Number!", newline,
           newline,
           "The computer will select a random whole number between 1 and 100.", newline,
           "Your goal is to guess that number. You will get a turn, then a computer", newline,
           "player will get a turn. Each of you are aware of the other's guesses.", newline,
           "The first one to guess the number correctly will win. Try to guess in", newline,
           "as few turns as possible.", newline,
           newline,
           "Here we go!", newline,
           newline,
           newline));

   # Get a random number, or a fixed one from GMN_SECRET for parity testing #
   INT secretnumber := ENTIER (random * 100) + 1;

   STRING gmnsecret = getenv ("GMN_SECRET");
   IF is all digits (gmnsecret) THEN
      INT value = digits to number (gmnsecret);
      IF value >= 1 AND value <= 100 THEN secretnumber := value FI
   FI;

   # set all our initial values #
   INT userguess := 0;
   INT computerguess;
   INT totalguesses := 0;
   INT lowmax := 1;
   INT highmax := 100;
   STRING userguessunvalidated;
   BOOL gameover := FALSE;

   # set by the event procedure when a read finds no more input #
   BOOL endofinput := FALSE;
   on logical file end (stand in, (REF FILE f) BOOL: (endofinput := TRUE; TRUE));

   # set by the event procedure when a read meets a form feed. a68g treats a
     form feed as the end of a page, not as a character, so the guess never
     contains one; this flag is how the loop learns that the line held one.
     Returning FALSE lets a68g go on to the next page and read the rest. #
   BOOL formfeed := FALSE;
   on page end (stand in, (REF FILE f) BOOL: (formfeed := TRUE; FALSE));

   # the main bit #
   WHILE NOT gameover DO
      print ("What is your guess? ");

      # let the user input any number they want #
      BOOL validguess := FALSE;
      endofinput := FALSE;
      formfeed := FALSE;
      read (userguessunvalidated);

      IF endofinput THEN
         # end of input #
         gameover := TRUE
      ELSE
         read (newline);

         # remove leading and trailing spaces and tabs #
         userguessunvalidated := trim (userguessunvalidated);

         # verify the guess is a whole number; a form feed anywhere in the
           line means it is not #
         IF formfeed OR NOT is all digits (userguessunvalidated) THEN
            print (("Only whole numbers from 1 to 100 are allowed.", newline,
                    "Please try again.", newline,
                    newline))
         ELSE
            # make sure the guess is an integer in the right range #
            userguess := digits to number (userguessunvalidated);
            IF userguess < 1 OR userguess > 100 THEN
               print (("Only whole numbers from 1 to 100 are allowed. Your guess is out of range.", newline,
                       "Please try again.", newline,
                       newline))
            ELSE
               validguess := TRUE
            FI
         FI
      FI;

      IF validguess THEN
         # this is a real guess, so count it #
         totalguesses +:= 1;

         # some taunts for silly errors in user guesses #
         IF userguess < lowmax THEN
            print (("That guess was lower than a previous guess that was too low. Pay attention!", newline,
                    newline))
         FI;
         IF userguess > highmax THEN
            print (("Wake up! That guess was higher than an earlier guess that was too high.", newline,
                    newline))
         FI;

         # evaluate the guess #
         IF userguess = secretnumber THEN
            print ((newline,
                    "*********************************************", newline,
                    "   Your guess is correct! Congratulations!", newline,
                    "   It took ", whole (totalguesses, 0), " total guesses.", newline,
                    "*********************************************", newline,
                    newline));
            gameover := TRUE
         ELIF userguess > secretnumber THEN
            print (("Your guess is too high.", newline,
                    newline));
            # don't let the computer choose this number or anything higher
              than this as long as a reasonable user guess was made #
            IF userguess <= highmax THEN highmax := userguess - 1 FI
         ELSE
            print (("Your guess is too low.", newline,
                    newline));
            # don't let the computer choose this number or anything lower
              than this as long as a reasonable user guess was made #
            IF userguess >= lowmax THEN lowmax := userguess + 1 FI
         FI
      FI;

      IF validguess AND NOT gameover THEN
         # the computer's guess uses a binary-search midpoint within current bounds #
         computerguess := (lowmax + highmax) OVER 2;
         totalguesses +:= 1;

         IF computerguess = secretnumber THEN
            print (("**********************************************", newline,
                    "   The computer's guess of ", whole (computerguess, 0), " is correct!", newline,
                    "   It took ", whole (totalguesses, 0), " total guesses.", newline,
                    "**********************************************", newline,
                    newline));
            gameover := TRUE
         ELIF computerguess > secretnumber THEN
            print (("The computer guessed ", whole (computerguess, 0), " and that was too high.", newline,
                    "Please try again.", newline,
                    newline));
            highmax := computerguess - 1
         ELSE
            print (("The computer guessed ", whole (computerguess, 0), " and that was too low.", newline,
                    "Please try again.", newline,
                    newline));
            lowmax := computerguess + 1
         FI
      FI;

      # these taunts are just for my amusement and to keep the game from being too terribly long #
      IF validguess AND NOT gameover THEN
         IF totalguesses = 8 THEN
            print ((newline,
                    "This is a hard number, isn't it?", newline,
                    newline))
         ELIF totalguesses = 10 THEN
            print ((newline,
                    "Wow! You are really bad at this.", newline,
                    newline))
         ELIF totalguesses >= 12 THEN
            print ((newline,
                    "You're taking too long, I can't handle it any more.", newline,
                    newline,
                    "G A M E   O V E R", newline,
                    newline));
            gameover := TRUE
         FI
      FI
   OD
END
